{
  "name": "obsidian-whatsapp-client",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp client for Obsidian (Evolution API) with customer and order workflows.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "deploy": "pnpm build && node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@types/node": "~22.20.5",
    "esbuild": "~0.24.2",
    "obsidian": "^1.14.4",
    "typescript": "~5.6.3",
    "vitest": "~2.1.9"
  }
}
